@baseUrl = http://localhost:3000

### --------- Pengujian Employee -------------
@ID_EMPLOYEE = cmv58y52o00016ov7k2ej9b73
### Buat employee
POST {{baseUrl}}/api/employees
Content-Type: application/json

{
  "name": "Test Employee F",
  "team": "TEAM_A"
}

### Ambil semua employee
GET {{baseUrl}}/api/employees

### Ambil satu employee
GET {{baseUrl}}/api/employees/{{ID_EMPLOYEE}}

### Update employee
PATCH {{baseUrl}}/api/employees/{{ID_EMPLOYEE}}
Content-Type: application/json

{
  "name": "Test Employee Updated",
  "status": "INACTIVE"
}

### Hapus employee
DELETE {{baseUrl}}/api/employees/{{ID_EMPLOYEE}}


### --------- Pengujian Attendance -------------
### Create Attendance
@ATTENDANCE_ID = cmv58yelw00026ov7fd73mnyx

POST {{baseUrl}}/api/attendance
Content-Type: application/json

{
  "employeeId": "{{EMPLOYEE_ID_A}}",
  "date": "2026-10-12T00:00:00.000Z",
  "status": "PRESENT",
  "notes": "Integration test attendance"
}

### Ambil daftar attendance
GET {{baseUrl}}/api/attendance

### Ambil detail attendance berdasarkan date
GET {{baseUrl}}/api/attendance?date=2026-10-12T00:00:00.000Z

### Ambil detail attendance berdasarkan employeeId
GET {{baseUrl}}/api/attendance?employeeId={{{{ID_EMPLOYEE}}}}

### Update attendance berdasarkan Id attendance
PATCH {{baseUrl}}/api/attendance/{{ATTENDANCE_ID}}
Content-Type: application/json

{
  "status": "ABSENT",
  "notes": "Updated during testing"
}

### --------- Pengujian Product -------------
@PRODUCT_ID = cmv59q3t800036ov7xilud6aq
### Buat Product
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "Test Egg Tray",
  "pcsPerBundle": 50
}

### Ambil semua product
GET {{baseUrl}}/api/products

### Ambil satu product
GET {{baseUrl}}/api/products/{{PRODUCT_ID}}

###
PATCH {{baseUrl}}/api/products/{{PRODUCT_ID}}
Content-Type: application/json

{
  "name": "Test Egg Tray Updated",
  "pcsPerBundle": 60,
  "isActive": false
}


### --------- Pengujian Productions -------------
POST {{baseUrl}}/api/productions
Content-Type: application/json

{
  "productId": "{{PRODUCT_ID}}",
  "date": "2026-10-12T00:00:00.000Z",
  "bundleQuantity": 10,
  "notes": "Test production"
}

### --------- Pengujian Inventory -------------
### Lihat seluruh stok
GET {{baseUrl}}/api/inventory

### Lihat stok Product berdasarkan Id
GET {{baseUrl}}/api/inventory/{{PRODUCT_ID}}

### Lihat riwayat transaksi
GET {{baseUrl}}/api/inventory/{{PRODUCT_ID}}/transactions?limit=20

### Catat stok rusak
POST {{baseUrl}}/api/inventory/damage
Content-Type: application/json

{
  "productId": "{{PRODUCT_ID}}",
  "bundleQuantity": 1,
  "notes": "Test damaged stock"
}

### --------- Pengujian Adjustment -------------
### Penyesuaian stok menambahkan 1 bundle / mengurangi 1 bundle
POST {{baseUrl}}/api/inventory/adjustment
Content-Type: application/json

{
  "productId": "{{PRODUCT_ID}}",
  "type": "ADJUSTMENT_IN",
  "bundleQuantity": 1,
  "notes": "Test stock adjustment"
}


### --------- Pengujian Payroll -------------
### Lihat Pengaturan Payroll
GET {{baseUrl}}/api/payroll/settings

### Ubah Pengaturan Payroll
PATCH {{baseUrl}}/api/payroll/settings
Content-Type: application/json

{
  "teamAPricePerPcs": 130,
  "teamADivisor": 5,
  "teamBDailyRate": 30000
}

### Buat Periode Payroll
POST {{baseUrl}}/api/payroll/periods
Content-Type: application/json

{
  "startDate": "2026-11-01T00:00:00.000Z",
  "endDate": "2026-11-15T00:00:00.000Z"
}

### Lihat Payrol Periode
GET {{baseUrl}}/api/payroll/periods

@PAYROLL_PERIOD_ID = cmv5cyfqb000qm0v7af1nzzhj
@EMPLOYEE_ID_A = cmv58y52o00016ov7k2ej9b73
@EMPLOYEE_ID_B = cmv5bkl850009m0v7gli9r7d2
@EMPLOYEE_ID_C = cmv5bkqob000am0v7c652id35
@EMPLOYEE_ID_D = cmv5bkyc8000bm0v7r1htsv8l
@EMPLOYEE_ID_E = cmv5bl22u000cm0v7ja1anqq7
@EMPLOYEE_ID_F = cmv5bl70q000dm0v72u1tdjgb

### memasukkan Payroll harian
POST {{baseUrl}}/api/payroll/daily
Content-Type: application/json

{
  "payrollPeriodId": "{{PAYROLL_PERIOD_ID}}",
  "date": "2026-11-12T00:00:00.000Z",
  "dayType": "NORMAL",
  "productionBundles": 100,
  "pcsPerBundle": 50,
  "teamAFullEmployeeIds": [
    "{{EMPLOYEE_ID_A}}",
    "{{EMPLOYEE_ID_B}}",
    "{{EMPLOYEE_ID_C}}",
    "{{EMPLOYEE_ID_D}}"
  ],
  "teamAHalfEmployeeIds": [
    "{{EMPLOYEE_ID_E}}",
    "{{EMPLOYEE_ID_F}}"
  ]
}

### Hitung Payroll
POST {{baseUrl}}/api/payroll/periods/{{PAYROLL_PERIOD_ID}}/calculate

### Laporan Payroll
GET {{baseUrl}}/api/payroll/periods/{{PAYROLL_PERIOD_ID}}/report

### Finalisasi Payroll
POST {{baseUrl}}/api/payroll/periods/{{PAYROLL_PERIOD_ID}}/finalize

### Lihat Payroll Periode berdasarkan Id
GET {{baseUrl}}/api/payroll/periods/{{PAYROLL_PERIOD_ID}}